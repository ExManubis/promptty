#!/usr/bin/env bash
# Builds libghostty into Engine/: Ghostty's source at the commit pinned below, with PrompTTY's
# patches (Engine/patches/, see its README) applied for the build. Needs Zig 0.16 and Xcode's
# Metal toolchain. Zig is $ZIG if set, else Homebrew's zig@0.16 wherever Homebrew lives, else the
# `zig` on PATH, as long as it is 0.16.
#
# Only the library is built, not Ghostty.app: the app's link step fails outside Ghostty's own CI
# and leaves libghostty-spm's build script waiting half an hour for an orphaned archive step.
# Without it a build takes a minute or so (a few the first time), and the symbol check below
# fails the build if a future Ghostty ever stops putting the embedding API in the library.
#
#   script/build-engine           build if Engine/GhosttyKit.xcframework is missing, or was built
#                                 from another Ghostty pin or other patches
#   script/build-engine --ios     with iOS and iOS simulator slices too, for the iPhone app
#                                 (a few minutes more; a Mac-only build takes them when present)
#   script/build-engine --force   rebuild anyway
#   ZIG=/path/to/zig script/build-engine
set -euo pipefail
cd "$(dirname "$0")/.."

REPO=https://github.com/ghostty-org/ghostty
PIN=431126c215dc324a53ef6f054264e951a4b21604
GHOSTTY=.build/engine/ghostty
OUT=Engine/GhosttyKit.xcframework
VT_OUT=Engine/GhosttyVt.xcframework
RESOURCES=Engine/Sources/GhosttyKitResources/Resources
REQUIRED_SYMBOLS=(ghostty_surface_new ghostty_surface_read_text_format ghostty_surface_blocks ghostty_surface_block_text
  ghostty_surface_set_output_tap ghostty_surface_feed ghostty_surface_read_vt_snapshot ghostty_surface_exec_plan
  ghostty_surface_host_exited)

fail() { echo "build-engine: $1" >&2; exit 1; }

force=false
target=native
for arg in "$@"; do
  case "$arg" in
    --force) force=true ;;
    --ios) target=ios ;;
    *) fail "unknown option $arg (--force, --ios)" ;;
  esac
done

# What the engine is built from: the pin and the patches, then the slices (native or ios). Kept
# beside the build, so a checkout that moves to another pin or other patches rebuilds instead of
# building the app against a stale header. An ios build serves a Mac-only one, not the reverse.
STAMP=$OUT/.built-from
stamp() { { echo "$PIN"; cat Engine/patches/*.patch; } | shasum -a 256 | cut -d' ' -f1; }
built=$(cat "$STAMP" 2>/dev/null || true)
if ! $force && [ -d "$OUT" ] && [ -d "$VT_OUT" ] && [ "${built%% *}" = "$(stamp)" ] \
  && { [ "$target" = native ] || [ "${built#* }" = ios ]; }; then
  echo "Engine already built ($OUT); --force rebuilds"
  exit 0
fi
if [ -z "${ZIG:-}" ]; then
  if command -v brew >/dev/null && [ -x "$(brew --prefix zig@0.16 2>/dev/null)/bin/zig" ]; then
    ZIG=$(brew --prefix zig@0.16)/bin/zig
  else
    ZIG=$(command -v zig || true)
  fi
fi
[ -n "$ZIG" ] && [ -x "$ZIG" ] || fail "needs Zig 0.16: brew install zig@0.16, or set ZIG=/path/to/zig"
case "$("$ZIG" version)" in
  0.16.*) ;;
  *) fail "$ZIG is Zig $("$ZIG" version); the pinned Ghostty needs 0.16 (brew install zig@0.16, or set ZIG)" ;;
esac

if [ ! -d "$GHOSTTY/.git" ]; then
  mkdir -p "$(dirname "$GHOSTTY")"
  git clone --quiet --filter=blob:none "$REPO" "$GHOSTTY"
fi
[ -z "$(git -C "$GHOSTTY" status --porcelain)" ] \
  || fail "$GHOSTTY has local changes (an interrupted build?): git -C $GHOSTTY checkout -- . && git -C $GHOSTTY clean -fd"
git -C "$GHOSTTY" cat-file -e "$PIN^{commit}" 2>/dev/null || git -C "$GHOSTTY" fetch --quiet origin
git -C "$GHOSTTY" checkout --quiet --detach "$PIN"

# Applied in order and reverted on exit, however the build ends; files the patches add are
# untracked, so they are listed after each apply and removed with the rest.
added=""
restore() {
  git -C "$GHOSTTY" checkout --quiet -- .
  while IFS= read -r file; do [ -z "$file" ] || rm -f "$GHOSTTY/$file"; done <<< "$added"
}
trap restore EXIT
for patch in Engine/patches/*.patch; do
  [ -e "$patch" ] || continue
  git -C "$GHOSTTY" apply "$PWD/$patch" \
    || fail "$(basename "$patch") does not apply to the pinned Ghostty; regenerate it (see Engine/patches/README.md)"
  added=$(git -C "$GHOSTTY" status --porcelain --untracked-files=all | sed -n 's/^?? //p')
  echo "applied $(basename "$patch")"
done

rm -rf "$GHOSTTY/zig-out" "$GHOSTTY/macos/GhosttyKit.xcframework"
(
  cd "$GHOSTTY"
  SDKROOT=$(xcrun --sdk macosx --show-sdk-path) "$ZIG" build \
    -Doptimize=ReleaseFast -Dstrip=false \
    -Demit-macos-app=false -Demit-xcframework=true -Dxcframework-target="$target"
)

# Every slice: macOS, and with --ios the iOS device and simulator.
LIBS=$(find "$GHOSTTY/macos/GhosttyKit.xcframework" -name "libghostty*.a")
[ -n "$LIBS" ] || fail "the build made no library"
while IFS= read -r lib; do
  symbols=$(nm -g "$lib" 2>/dev/null)
  for symbol in "${REQUIRED_SYMBOLS[@]}"; do
    grep -q " T _$symbol\$" <<< "$symbols" || fail "$(basename "$(dirname "$lib")") lacks $symbol"
  done
done <<< "$LIBS"

# libghostty-vt, for prompttyd's headless terminals (Engine/GhosttyVt.xcframework).
VT_PREFIX=$(mktemp -d)
(
  cd "$GHOSTTY"
  SDKROOT=$(xcrun --sdk macosx --show-sdk-path) "$ZIG" build \
    -Doptimize=ReleaseFast -Dstrip=false -Demit-lib-vt=true --prefix "$VT_PREFIX"
)
VT_FRAMEWORK=$VT_PREFIX/lib/ghostty-vt.xcframework
vt_symbols=$(nm -g "$VT_FRAMEWORK/macos-arm64_x86_64/libghostty-vt.a" 2>/dev/null)
grep -q " T _ghostty_terminal_vt_snapshot_alloc\$" <<< "$vt_symbols" \
  || fail "libghostty-vt lacks ghostty_terminal_vt_snapshot_alloc"

SHARE=$GHOSTTY/zig-out/share
[ -f "$SHARE/terminfo/78/xterm-ghostty" ] || fail "the build made no terminfo"
rm -rf "$OUT" "$RESOURCES" "$VT_OUT"
ditto "$GHOSTTY/macos/GhosttyKit.xcframework" "$OUT"
ditto "$VT_FRAMEWORK" "$VT_OUT"
# Xcode copies every xcframework's headers into one include folder. GhosttyKit's module map names
# its one header plainly: as an umbrella header it would claim every header in that folder,
# GhosttyVt's too, and `import GhosttyVt` would find nothing. GhosttyVt's goes in a folder of its
# own beside it, where clang finds GhosttyVt/module.modulemap by the module's name.
for headers in "$OUT"/*/Headers; do
  printf 'module GhosttyKit {\n    header "ghostty.h"\n    export *\n}\n' > "$headers/module.modulemap"
done
for headers in "$VT_OUT"/*/Headers; do
  mkdir -p "$headers/GhosttyVt"
  printf 'module GhosttyVt {\n    header "../ghostty/vt.h"\n    export *\n}\n' > "$headers/GhosttyVt/module.modulemap"
  rm "$headers/module.modulemap"
done
rm -rf "$VT_PREFIX"
echo "$(stamp) $target" > "$STAMP"
mkdir -p "$RESOURCES/ghostty"
ditto "$SHARE/terminfo" "$RESOURCES/terminfo"
ditto "$SHARE/ghostty/shell-integration" "$RESOURCES/ghostty/shell-integration"
ditto "$SHARE/ghostty/themes" "$RESOURCES/ghostty/themes"
# Some of Ghostty's shell integration scripts derive from Kitty's and are GPL-3.0.
cp Engine/licenses/GPL-3.0.txt "$RESOURCES/ghostty/shell-integration/GPL-3.0.txt"
echo "Engine built: $OUT"

#!/usr/bin/env bash
# Builds PrompTTY for distribution outside the App Store: a Release build signed with the
# Developer ID, notarized by Apple and stapled, in a signed and notarized disk image in dist/
# (the app and an Applications link on PrompTTY's background).
#
#   script/release                 build, sign, notarize, staple, make the disk image
#   script/release --no-notarize   the same without Apple: signed only, to check the build
#                                  and the disk image's window
#
# Needs uv (brew install uv), which fetches the Python packages that write the DMG's layout.
#
# Notarization signs in with a notarytool keychain profile ("promptty", or $NOTARY_PROFILE),
# created once with an app-specific password from account.apple.com:
#   xcrun notarytool store-credentials promptty --apple-id <your Apple ID> --team-id RQ2CW4W282
set -euo pipefail
cd "$(dirname "$0")/.."

notarize=1
case "${1:-}" in
  --no-notarize) notarize=0 ;;
  "") ;;
  *) echo "usage: script/release [--no-notarize]" >&2; exit 2 ;;
esac
PROFILE=${NOTARY_PROFILE:-promptty}
DERIVED=.build/release
APP=$DERIVED/Build/Products/Release/PrompTTY.app
LOG=$DERIVED/build.log

step() { printf '\n==> %s\n' "$*"; }
fail() { printf '\nrelease: %s\n' "$*" >&2; exit 1; }

step "Checking the signing identity, the notary profile and uv"
security find-identity -v -p codesigning | grep -q '"Developer ID Application' \
  || fail "no \"Developer ID Application\" certificate in the keychain"
command -v uv >/dev/null || fail "uv is needed to lay out the disk image: brew install uv"
if [ "$notarize" = 1 ]; then
  xcrun notarytool history --keychain-profile "$PROFILE" >/dev/null 2>&1 \
    || fail "no notarytool profile \"$PROFILE\"; create it with: xcrun notarytool store-credentials $PROFILE --apple-id <your Apple ID> --team-id RQ2CW4W282"
fi
[ -z "$(git status --porcelain)" ] || echo "note: the working tree has uncommitted changes; they are in this build"

step "Building the engine (when the Ghostty pin or a patch changed)"
script/build-engine

step "Building Release"
mkdir -p "$DERIVED"
rm -rf "$APP"
xcodegen generate >/dev/null
# The build number is the commit count, as in script/run, so each release is newer than the last.
if ! xcodebuild -project PrompTTY.xcodeproj -scheme PrompTTYApp -configuration Release \
    -destination "platform=macOS,arch=arm64" -derivedDataPath "$DERIVED" \
    CURRENT_PROJECT_VERSION="$(git rev-list --count HEAD)" build >"$LOG" 2>&1; then
  grep -E ' error: ' "$LOG" | head -20 >&2 || tail -30 "$LOG" >&2
  fail "the build failed (full log: $LOG)"
fi
VERSION=$(/usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$APP/Contents/Info.plist")
BUILD=$(/usr/libexec/PlistBuddy -c "Print CFBundleVersion" "$APP/Contents/Info.plist")
echo "PrompTTY $VERSION ($BUILD)"

step "Verifying the signature"
codesign --verify --deep --strict --verbose=2 "$APP" 2>&1 | tail -2
SIGNATURE=$(codesign -dvv "$APP" 2>&1)
grep -q "Authority=Developer ID Application" <<<"$SIGNATURE" || fail "not signed with a Developer ID Application certificate"
grep -q "flags=.*runtime" <<<"$SIGNATURE" || fail "the hardened runtime is off; notarization would reject it"
grep -q "Timestamp=" <<<"$SIGNATURE" || fail "the signature has no secure timestamp; notarization would reject it"
if codesign -d --entitlements - "$APP" 2>/dev/null | grep -q "get-task-allow"; then
  fail "the app carries the get-task-allow (debugging) entitlement; notarization would reject it"
fi
grep -E "^(Authority=Developer ID Application|TeamIdentifier|Timestamp)" <<<"$SIGNATURE"

# Sends a file to Apple and waits for the verdict; on a rejection prints Apple's log.
notarize() {
  local file=$1 result status id
  result=$(xcrun notarytool submit "$file" --keychain-profile "$PROFILE" --wait --output-format json) \
    || fail "submitting $file failed: $result"
  status=$(plutil -extract status raw -o - - <<<"$result")
  id=$(plutil -extract id raw -o - - <<<"$result")
  if [ "$status" != "Accepted" ]; then
    xcrun notarytool log "$id" --keychain-profile "$PROFILE" >&2 || true
    fail "notarization of $file: $status (submission $id)"
  fi
  echo "Accepted (submission $id)"
}

if [ "$notarize" = 1 ]; then
  # The app first, so the copy people drag out of the DMG carries its own ticket.
  step "Notarizing the app (usually a few minutes)"
  SUBMISSION=$DERIVED/PrompTTY-notarize.zip
  rm -f "$SUBMISSION"
  ditto -c -k --keepParent "$APP" "$SUBMISSION"
  notarize "$SUBMISSION"
  xcrun stapler staple "$APP"
  spctl --assess --type execute --verbose=2 "$APP"
fi

step "Making the disk image"
# The window: the app and an Applications link on the first PrompTTY's background, laid out
# by packaging/dmg_layout.py (written into .DS_Store; Finder on macOS 26 keeps nothing else).
STAGE=$DERIVED/dmg
RW=$DERIVED/PrompTTY-rw.dmg
mkdir -p dist
DMG=dist/PrompTTY-$VERSION-$BUILD.dmg
rm -rf "$STAGE" "$RW" "$DMG"
mkdir -p "$STAGE/.background"
ditto "$APP" "$STAGE/PrompTTY.app"
ln -s /Applications "$STAGE/Applications"
# One TIFF with both resolutions: sharp on Retina screens, and the right size on others.
tiffutil -cathidpicheck packaging/dmg-background.png packaging/dmg-background@2x.png \
  -out "$STAGE/.background/background.tiff" >/dev/null 2>&1
# APFS: macOS 26.4 has trouble mounting HFS+ images (see its release notes on external media).
hdiutil create -quiet -volname PrompTTY -srcfolder "$STAGE" -fs APFS -format UDRW -ov "$RW"
# (hdiutil calls -nobrowse deprecated in favor of diskutil, whose output differs; it still works.)
ATTACHED=$(hdiutil attach -nobrowse -noautoopen -readwrite "$RW" 2> >(grep -v deprecated >&2))
MOUNT=$(grep -o '/Volumes/.*' <<<"$ATTACHED" | tail -1)
[ -n "$MOUNT" ] || fail "could not mount the disk image: $ATTACHED"
if ! uv run --quiet --with ds_store --with mac_alias python3 packaging/dmg_layout.py \
    --mount-dir "$MOUNT" --app-name PrompTTY.app --background .background/background.tiff; then
  hdiutil detach -quiet -force "$MOUNT" || true
  fail "could not write the disk image's window layout"
fi
sync
hdiutil detach -quiet "$MOUNT"
hdiutil convert -quiet "$RW" -format UDZO -imagekey zlib-level=9 -o "$DMG"
rm -rf "$STAGE" "$RW"
codesign --sign "Developer ID Application" --timestamp "$DMG"
codesign --verify --verbose=2 "$DMG" 2>&1 | tail -1

if [ "$notarize" = 1 ]; then
  step "Notarizing the disk image"
  notarize "$DMG"
  xcrun stapler staple "$DMG"
  spctl --assess --type open --context context:primary-signature --verbose=2 "$DMG"
else
  echo "note: signed, not notarized; other Macs will refuse it until it is"
fi

printf '\n%s\nsha256 %s\n' "$DMG" "$(shasum -a 256 "$DMG" | cut -d' ' -f1)"

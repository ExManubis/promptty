diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index eb54292d6..f84e8bf2a 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -2197,6 +2197,52 @@ pub const CAPI = struct {
         surface.core_surface.io.processOutput(ptr[0..len]);
     }
 
+    /// PrompTTY: the terminal's state as VT bytes that rebuild it in a fresh
+    /// terminal of the same size: at most `scrollback` rows of scrollback,
+    /// the screen, cursor, modes, alternate screen and the sequence the pty
+    /// output stopped in the middle of (see terminal/vt_snapshot.zig).
+    /// `callback`, if set, gets the grid size with the terminal still
+    /// locked: the output tap's chunks so far are in the snapshot, the next
+    /// ones are not. Free the result with ghostty_surface_free_text.
+    export fn ghostty_surface_read_vt_snapshot(
+        surface: *Surface,
+        scrollback: u32,
+        callback: ?*const fn (?*anyopaque, u16, u16) callconv(.c) void,
+        userdata: ?*anyopaque,
+        result: *Text,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        const alloc = global.alloc();
+        var builder: std.Io.Writer.Allocating = .init(alloc);
+        defer builder.deinit();
+        {
+            core_surface.renderer_state.mutex.lockUncancelable(global.io());
+            defer core_surface.renderer_state.mutex.unlock(global.io());
+            const t = core_surface.renderer_state.terminal;
+            terminal.vt_snapshot.write(alloc, t, &builder.writer, .{
+                .scrollback = scrollback,
+            }) catch |err| {
+                log.warn("error writing vt snapshot err={}", .{err});
+                return false;
+            };
+            terminal.vt_snapshot.writeContinuation(
+                &core_surface.io.terminal_stream,
+                &builder.writer,
+            ) catch return false;
+            if (callback) |cb| cb(userdata, t.cols, t.rows);
+        }
+        const bytes = builder.toOwnedSliceSentinel(0) catch return false;
+        result.* = .{
+            .tl_px_x = -1,
+            .tl_px_y = -1,
+            .offset_start = 0,
+            .offset_len = 0,
+            .text = bytes.ptr,
+            .text_len = bytes.len,
+        };
+        return true;
+    }
+
     /// Tell the surface that it needs to schedule a render
     export fn ghostty_surface_refresh(surface: *Surface) void {
         surface.refresh();

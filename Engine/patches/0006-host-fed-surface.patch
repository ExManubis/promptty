diff --git a/src/termio/Host.zig b/src/termio/Host.zig
new file mode 100644
index 000000000..876a14b6c
--- /dev/null
+++ b/src/termio/Host.zig
@@ -0,0 +1,202 @@
+//! Host is the backend for a terminal whose program runs somewhere the
+//! embedder reaches and we don't: on another machine, or anywhere from
+//! iOS, which can't start one. Nothing is spawned and there is no pty.
+//! The embedder feeds the program's output in (Termio.processOutput, the
+//! C API's ghostty_surface_feed) and gets back, through callbacks, what
+//! the terminal writes to the program (keys, paste, mouse and focus
+//! reports, query replies) and every new grid size.
+const Host = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+/// Called with bytes for the program, in order.
+pub const WriteFn = *const fn (
+    userdata: ?*anyopaque,
+    data: [*]const u8,
+    len: usize,
+) callconv(.c) void;
+
+/// Called with the new grid (and its size in pixels, padding excluded),
+/// as a pty would get TIOCSWINSZ.
+pub const ResizeFn = *const fn (
+    userdata: ?*anyopaque,
+    columns: u16,
+    rows: u16,
+    width_px: u32,
+    height_px: u32,
+) callconv(.c) void;
+
+/// Both callbacks run on the surface's IO thread, sometimes with the
+/// terminal locked: they must copy what they need and return without
+/// calling back into the surface.
+pub const Config = struct {
+    userdata: ?*anyopaque = null,
+    write: WriteFn,
+    resize: ?ResizeFn = null,
+};
+
+config: Config,
+
+pub fn init(config: Config) Host {
+    return .{ .config = config };
+}
+
+pub fn deinit(self: *Host) void {
+    _ = self;
+}
+
+pub fn initTerminal(self: *Host, t: *terminal.Terminal) void {
+    // The first grid reaches the host with the surface's first resize,
+    // on the IO thread like every later one.
+    _ = self;
+    _ = t;
+}
+
+pub fn threadEnter(
+    self: *Host,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = self;
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .host = .{} };
+}
+
+pub fn threadExit(self: *Host, td: *termio.Termio.ThreadData) void {
+    _ = self;
+    _ = td;
+}
+
+pub fn focusGained(
+    self: *Host,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    // Focus reports (mode 1004) are written by Termio itself; Exec only
+    // polls termios here, which a host has none of.
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *Host,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    const f = self.config.resize orelse return;
+    f(
+        self.config.userdata,
+        grid_size.columns,
+        grid_size.rows,
+        screen_size.width,
+        screen_size.height,
+    );
+}
+
+pub fn queueWrite(
+    self: *Host,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+    if (!linefeed) {
+        if (data.len > 0) self.config.write(self.config.userdata, data.ptr, data.len);
+        return;
+    }
+
+    // Linefeed mode (LNM): every \r goes out as \r\n, as Exec does.
+    var buf: [256]u8 = undefined;
+    var len: usize = 0;
+    for (data) |ch| {
+        if (len + 2 > buf.len) {
+            self.config.write(self.config.userdata, &buf, len);
+            len = 0;
+        }
+        buf[len] = ch;
+        len += 1;
+        if (ch == '\r') {
+            buf[len] = '\n';
+            len += 1;
+        }
+    }
+    if (len > 0) self.config.write(self.config.userdata, &buf, len);
+}
+
+pub fn childExitedAbnormally(
+    self: *Host,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    // There is no child.
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+pub fn getProcessInfo(self: *Host, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    // The program and its pty are the host's.
+    _ = self;
+    return null;
+}
+
+/// Host keeps no state on the IO thread.
+pub const ThreadData = struct {
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+const testing = std.testing;
+
+const TestSink = struct {
+    out: [64]u8 = undefined,
+    len: usize = 0,
+    grid: [2]u16 = .{ 0, 0 },
+
+    fn write(ud: ?*anyopaque, data: [*]const u8, len: usize) callconv(.c) void {
+        const self: *TestSink = @ptrCast(@alignCast(ud.?));
+        @memcpy(self.out[self.len..][0..len], data[0..len]);
+        self.len += len;
+    }
+
+    fn resize(ud: ?*anyopaque, columns: u16, rows: u16, _: u32, _: u32) callconv(.c) void {
+        const self: *TestSink = @ptrCast(@alignCast(ud.?));
+        self.grid = .{ columns, rows };
+    }
+};
+
+test "Host: writes go to the callback, with CRLF in linefeed mode" {
+    var sink: TestSink = .{};
+    var host: Host = .init(.{
+        .userdata = &sink,
+        .write = TestSink.write,
+        .resize = TestSink.resize,
+    });
+    var td: termio.Termio.ThreadData = undefined;
+
+    try host.queueWrite(testing.allocator, &td, "ls\r", false);
+    try testing.expectEqualStrings("ls\r", sink.out[0..sink.len]);
+
+    sink.len = 0;
+    try host.queueWrite(testing.allocator, &td, "a\rb\r", true);
+    try testing.expectEqualStrings("a\r\nb\r\n", sink.out[0..sink.len]);
+
+    try host.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
+    try testing.expectEqual([2]u16{ 80, 24 }, sink.grid);
+}

diff --git a/src/termio/Exec.zig b/src/termio/Exec.zig
index 2dfb1e5f7..c9ec5b7f3 100644
--- a/src/termio/Exec.zig
+++ b/src/termio/Exec.zig
@@ -60,6 +60,52 @@ pub fn deinit(self: *Exec) void {
     self.subprocess.deinit();
 }
 
+/// PrompTTY: what `cfg` would start, without starting it: the arguments
+/// (shell integration and login(1) applied), the environment and the working
+/// directory, as JSON ({"args":[...],"env":{...},"cwd":...}). For a program
+/// that runs on a pty an embedder owns, feeding a surface with termio's host
+/// backend. Owned by `alloc`.
+pub fn plan(alloc: Allocator, cfg: Config) ![]u8 {
+    var subprocess = try Subprocess.init(alloc, cfg);
+    defer subprocess.deinit();
+
+    var out: std.Io.Writer.Allocating = .init(alloc);
+    errdefer out.deinit();
+    const w = &out.writer;
+    try w.writeAll("{\"args\":[");
+    for (subprocess.args, 0..) |arg, i| {
+        if (i > 0) try w.writeByte(',');
+        try writeJsonString(w, arg);
+    }
+    try w.writeAll("],\"env\":{");
+    if (subprocess.env) |*env| {
+        var it = env.iterator();
+        var first = true;
+        while (it.next()) |pair| {
+            if (!first) try w.writeByte(',');
+            first = false;
+            try writeJsonString(w, pair.key_ptr.*);
+            try w.writeByte(':');
+            try writeJsonString(w, pair.value_ptr.*);
+        }
+    }
+    try w.writeAll("},\"cwd\":");
+    if (subprocess.cwd) |cwd| try writeJsonString(w, cwd) else try w.writeAll("null");
+    try w.writeByte('}');
+    return try out.toOwnedSlice();
+}
+
+fn writeJsonString(w: *std.Io.Writer, s: []const u8) !void {
+    try w.writeByte('"');
+    for (s) |ch| switch (ch) {
+        '"' => try w.writeAll("\\\""),
+        '\\' => try w.writeAll("\\\\"),
+        0...0x1f => try w.print("\\u{x:0>4}", .{ch}),
+        else => try w.writeByte(ch),
+    };
+    try w.writeByte('"');
+}
+

+/// PrompTTY: hands a program's status report (OSC 7501) to the apprt,
+/// decoded.
+fn programStatus(self: *Surface, report: terminal.osc.Command.ProgramStatus.Report) void {
+    const ps = terminal.osc.program_status;
+    const State = apprt.action.ProgramStatus.State;
+    const Kind = apprt.action.ProgramStatus.Kind;
+
+    var id_buf: [ps.max_id_bytes + 1]u8 = undefined;
+    var app_buf: [ps.max_app_bytes + 1]u8 = undefined;
+    var title_buf: [ps.max_title_bytes + 1]u8 = undefined;
+    var msg_buf: [ps.max_msg_bytes + 1]u8 = undefined;
+
+    const value: apprt.action.ProgramStatus.Report = .{
+        .state = switch (report.state) {
+            .idle => State.idle,
+            .working => .working,
+            .done => .done,
+            .blocked => .blocked,
+            .@"error" => .@"error",
+            .clear => .clear,
+        },
+        .kind = if (report.readOption(.kind)) |kind| switch (kind) {
+            .permission => Kind.permission,
+            .question => .question,
+            .auth => .auth,
+        } else .none,
+        .progress = if (report.readOption(.progress)) |p| @intCast(p) else -1,
+        .id = copyZ(&id_buf, report.readOption(.id)),
+        .app = copyZ(&app_buf, report.readOption(.app)),
+        .title = decodeZ(report, .title, &title_buf),
+        .msg = decodeZ(report, .msg, &msg_buf),
+    };
+
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .program_status,
+        .{ .report = &value },
+    ) catch |err| {
+        log.warn("apprt failed to report program status err={}", .{err});
+    };
+}
+
+fn copyZ(buf: []u8, value: ?[]const u8) ?[*:0]const u8 {
+    const v = value orelse return null;
+    if (v.len >= buf.len) return null;
+    @memcpy(buf[0..v.len], v);
+    buf[v.len] = 0;
+    return buf[0..v.len :0].ptr;
+}
+
+fn decodeZ(
+    report: terminal.osc.Command.ProgramStatus.Report,
+    comptime option: terminal.osc.Command.ProgramStatus.Option,
+    buf: []u8,
+) ?[*:0]const u8 {
+    if (report.readOption(option) == null) return null;
+    var writer: std.Io.Writer = .fixed(buf[0 .. buf.len - 1]);
+    report.writeText(option, &writer) catch return null;
+    const len = writer.buffered().len;
+    buf[len] = 0;
+    return buf[0..len :0].ptr;
+}

 /// The desktop notification to show.
+/// PrompTTY: one OSC 7501 report, decoded. A report replaces its record
+/// (`id`, null for the program's own) completely; `clear` removes the
+/// record and every record under it, or every record without an id. The
+/// report is only valid for the duration of the action; its text is
+/// untrusted, valid UTF-8 without control characters.
+pub const ProgramStatus = struct {
+    report: *const Report,
+
+    // Sync with: ghostty_action_program_status_state_e
+    pub const State = enum(c_int) { idle, working, done, blocked, @"error", clear };
+
+    // Sync with: ghostty_action_program_status_kind_e
+    pub const Kind = enum(c_int) { none = -1, permission, question, auth };
+
+    // Sync with: ghostty_action_program_status_s
+    pub const Report = extern struct {
+        state: State,
+        /// What a blocked program needs from the user.
+        kind: Kind = .none,
+        /// 0...100 for a working or blocked program; -1 when it gave none.
+        progress: i8 = -1,
+        id: ?[*:0]const u8 = null,
+        app: ?[*:0]const u8 = null,
+        title: ?[*:0]const u8 = null,
+        msg: ?[*:0]const u8 = null,
+    };
+
+    pub const C = *const Report;
+
+    pub fn cval(self: ProgramStatus) C {
+        return self.report;
+    }
+};

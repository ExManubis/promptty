diff --git a/src/terminal/blocks.zig b/src/terminal/blocks.zig
new file mode 100644
index 000000000..89cf0a88d
--- /dev/null
+++ b/src/terminal/blocks.zig
@@ -0,0 +1,988 @@
+//! Command blocks: each command the shell ran, found from its semantic
+//! prompt marks (OSC 133), with the output it printed. A block starts on
+//! the first row of a prompt that has input and runs to the last row with
+//! text before the next prompt.
+const std = @import("std");
+const testing = std.testing;
+const Screen = @import("Screen.zig");
+const PageList = @import("PageList.zig");
+const Pin = PageList.Pin;
+const Selection = @import("Selection.zig");
+
+pub const Block = struct {
+    /// Screen row of the block's first line: where its command is.
+    row: u32,
+
+    /// Screen row of the block's last line with text (at least `row`).
+    end_row: u32,
+
+    /// The command's exit status, when the shell reported it.
+    exit_code: ?u8,
+};
+
+/// Records the exit status the shell reported (OSC 133;D) on the prompt
+/// of the command that just finished: the one `running` found when its
+/// output started, or else the nearest prompt at or above the cursor.
+pub fn markExit(screen: *Screen, running: ?*RunningCommand, code: i32) void {
+    const prompt = (if (running) |r| r.prompt(screen) else null) orelse prompt: {
+        var it = screen.cursor.page_pin.promptIterator(.left_up, null);
+        break :prompt it.next() orelse return;
+    };
+    const status: u8 = @intCast(std.math.clamp(code, 0, 255));
+    prompt.rowAndCell().row.command_exit = @as(u9, status) + 1;
+    if (running) |r| r.exited = true;
+}
+
+/// The prompt of the command running, found when its output starts (OSC
+/// 133;C), so that its exit status (133;D, which integrations may send
+/// twice) is kept without a walk up through all it printed. For the
+/// primary screen only, which lives as long as the terminal: its pin is
+/// tracked by that screen's page list and freed with it.
+pub const RunningCommand = struct {
+    pin: ?*Pin = null,
+    /// The page list's history_generation when it was found.
+    generation: u32 = 0,
+    valid: bool = false,
+    /// Its exit status was recorded: the next output is another command's.
+    exited: bool = false,
+
+    /// A prompt starts (OSC 133;A or P).
+    pub fn promptStarted(self: *RunningCommand) void {
+        self.valid = false;
+    }
+
+    /// Output starts (OSC 133;C, which integrations may send more than
+    /// once): the command's prompt is the nearest at or above the cursor.
+    pub fn outputStarted(self: *RunningCommand, screen: *Screen) void {
+        if (self.valid and !self.exited) return;
+        self.valid = false;
+        var it = screen.cursor.page_pin.promptIterator(.left_up, null);
+        const found = it.next() orelse return;
+        if (self.pin == null) self.pin = screen.pages.trackPin(found) catch return;
+        self.pin.?.* = found;
+        self.generation = screen.pages.history_generation;
+        self.valid = true;
+        self.exited = false;
+    }
+
+    /// The command's prompt, unless it is unknown or its rows were moved
+    /// (a resize, erase or reset) or pruned since.
+    fn prompt(self: *const RunningCommand, screen: *const Screen) ?Pin {
+        if (!self.valid) return null;
+        const p = self.pin.?.*;
+        if (p.garbage or self.generation != screen.pages.history_generation or
+            p.rowAndCell().row.semantic_prompt == .none) return null;
+        return p;
+    }
+};
+
+/// Which blocks `list` writes.
+pub const Range = union(enum) {
+    /// The newest.
+    all,
+
+    /// Those with a row from `top` to `bottom` (screen rows, inclusive),
+    /// and the one before them: the overlay of a screen showing those rows
+    /// draws the line above the first and names a command scrolled off.
+    rows: struct { top: u32, bottom: u32 },
+};
+
+pub const Listing = struct {
+    /// How many blocks were written.
+    len: usize = 0,
+
+    /// How many blocks come after the last one written: those that start
+    /// below the rows asked for.
+    newer: u32 = 0,
+};
+
+/// Fills `out` with the blocks on `screen` in `range`, the newest that
+/// fit, oldest first. One walk up from the bottom of the screen that ends
+/// as soon as `range` is covered; with a `hint` kept between calls, it
+/// also skips the history it walked through before: from the newest row
+/// of history to the prompt above it, from there over the prompts below
+/// the rows asked for, and from the top prompt in them to the one above.
+pub fn list(screen: *Screen, range: Range, out: []Block, hint: ?*Hint) Listing {
+    var result: Listing = .{};
+    if (out.len == 0 or !screen.semantic_prompt.seen) return result;
+    var walk = Walk.init(screen, hint) orelse return result;
+    var learner: SpanLearner = .{
+        .active_top = @intCast(screen.pages.total_rows - screen.pages.rows),
+    };
+
+    // The first row of the prompt below the one being looked at.
+    var below: ?Row = null;
+    while (walk.next()) |prompt| {
+        const under = below;
+        below = prompt;
+        const input = hasInput(prompt.pin, if (under) |b| b.pin else null);
+        const above_range = switch (range) {
+            .all => false,
+            .rows => |rows| above: {
+                learner.saw(rows, prompt, under, input);
+                if (prompt.y > rows.bottom) {
+                    if (input) result.newer += 1;
+                    break :above false;
+                }
+                break :above prompt.y < rows.top;
+            },
+        };
+        if (input and (range == .all or prompt.y <= range.rows.bottom)) {
+            const last: Row = if (under) |b| (b.up() orelse prompt) else walk.bottom;
+            const command_exit = prompt.pin.rowAndCell().row.command_exit;
+            out[result.len] = .{
+                .row = prompt.y,
+                .end_row = lastRowWithText(prompt, last).y,
+                .exit_code = if (command_exit == 0) null else @intCast(command_exit - 1),
+            };
+            result.len += 1;
+            if (result.len == out.len or above_range) break;
+        }
+
+        // Skip the prompts after this one that an earlier walk passed.
+        if (range == .rows) if (hint) |h| if (h.skip(screen, prompt, range.rows.bottom)) |s| {
+            result.newer += s.count;
+            learner.skipped(s);
+            below = s.last;
+            walk.current = s.to;
+        };
+    } else if (range == .rows) learner.ended(range.rows, below);
+    if (range == .rows) if (hint) |h| learner.teach(h, screen);
+    std.mem.reverse(Block, out[0..result.len]);
+    return result;
+}
+
+/// What walks up the screen learned about history, which changes only by
+/// being pruned (which marks the pins garbage) or by a resize, erase or
+/// reset (which the page list counts), so that the next walk can skip it:
+/// - after passing the newest row of history, where the nearest prompt
+///   above it is, or that there is none;
+/// - spans of prompts in history: from one prompt, the prompts after it
+///   up to `last`, and the prompt after that.
+/// Keep one per terminal. Its pins are tracked by the screen's page list
+/// and freed with it.
+pub const Hint = struct {
+    screen: ?*const Screen = null,
+    /// A row of history...
+    from: ?*Pin = null,
+    /// ...and the first row of the nearest prompt at or above it, unless
+    /// `none`: no prompt at or above it...
+    prompt: ?*Pin = null,
+    none: bool = false,
+    /// ...that many rows above it.
+    dy: u32 = 0,
+    /// The page list's history_generation when it was learned.
+    generation: u32 = 0,
+    valid: bool = false,
+
+    /// The prompts below the rows a walk was asked for, and the prompts at
+    /// the top of them.
+    below: Span = .{},
+    above: Span = .{},
+
+    const Jump = struct { from: Pin, to: ?Pin, dy: u32 };
+
+    fn jump(self: *Hint, screen: *const Screen) ?Jump {
+        if (!self.valid or self.screen != screen) return null;
+        const from = self.from.?.*;
+        const to: ?Pin = if (self.none) null else self.prompt.?.*;
+        if (self.generation != screen.pages.history_generation or from.garbage or
+            if (to) |p| p.garbage or p.rowAndCell().row.semantic_prompt == .none else false)
+        {
+            self.valid = false;
+            return null;
+        }
+        return .{ .from = from, .to = to, .dy = self.dy };
+    }
+
+    fn remember(self: *Hint, screen: *Screen, from: Row, prompt: ?Row) void {
+        const pages = &screen.pages;
+        self.own(screen);
+        self.valid = false;
+        if (self.from == null) self.from = pages.trackPin(from.pin) catch return;
+        self.from.?.* = from.pin;
+        if (prompt) |p| {
+            if (self.prompt == null) self.prompt = pages.trackPin(p.pin) catch return;
+            self.prompt.?.* = p.pin;
+        }
+        self.none = prompt == null;
+        self.dy = if (prompt) |p| from.y - p.y else 0;
+        self.generation = pages.history_generation;
+        self.valid = true;
+    }
+
+    fn own(self: *Hint, screen: *const Screen) void {
+        // Pins of another screen stay with its page list.
+        if (self.screen != screen) self.* = .{ .screen = screen };
+    }
+
+    /// A walk that found `prompt` may go on from `to`, as if it had just
+    /// found `last`, with `count` more blocks found on the way.
+    const Skip = struct { count: u32, last: Row, to: ?Row };
+
+    /// Where a walk that found `prompt` can go on from, without finding
+    /// any prompt at or above row `bottom` on the way.
+    fn skip(self: *Hint, screen: *const Screen, prompt: Row, bottom: u32) ?Skip {
+        if (self.screen != screen) return null;
+        inline for (.{ &self.below, &self.above }) |span| {
+            if (span.skip(screen, prompt, bottom)) |s| return s;
+        }
+        return null;
+    }
+
+    /// Prompts in history: after `from`, the prompts up to `last` (`from`
+    /// itself when there are none), `count` of them with a command, and
+    /// then `to`, unless `none`: no prompt above `last`.
+    const Span = struct {
+        from: ?*Pin = null,
+        last: ?*Pin = null,
+        to: ?*Pin = null,
+        none: bool = false,
+        count: u32 = 0,
+        /// How many rows `last` and `to` are above `from`.
+        last_dy: u32 = 0,
+        to_dy: u32 = 0,
+        generation: u32 = 0,
+        valid: bool = false,
+
+        fn skip(self: *Span, screen: *const Screen, prompt: Row, bottom: u32) ?Skip {
+            if (!self.valid or !prompt.eql(self.from.?.*)) return null;
+            const last = self.last.?.*;
+            const to: ?Pin = if (self.none) null else self.to.?.*;
+            const prompts = isPrompt(self.from.?.*) and isPrompt(last) and
+                if (to) |p| isPrompt(p) else true;
+            if (self.generation != screen.pages.history_generation or !prompts or
+                @max(self.last_dy, self.to_dy) > prompt.y)
+            {
+                self.valid = false;
+                return null;
+            }
+            // The prompts skipped must all be below the rows asked for.
+            if (self.last_dy > 0 and prompt.y - self.last_dy <= bottom) return null;
+            return .{
+                .count = self.count,
+                .last = .{ .pin = last, .y = prompt.y - self.last_dy },
+                .to = if (to) |p| .{ .pin = p, .y = prompt.y - self.to_dy } else null,
+            };
+        }
+
+        fn remember(self: *Span, pages: *PageList, from: Row, last: Row, to: ?Row, count: u32) void {
+            self.valid = false;
+            inline for (.{ .{ &self.from, from }, .{ &self.last, last } }) |pair| {
+                if (pair[0].* == null) pair[0].* = pages.trackPin(pair[1].pin) catch return;
+                pair[0].*.?.* = pair[1].pin;
+            }
+            if (to) |p| {
+                if (self.to == null) self.to = pages.trackPin(p.pin) catch return;
+                self.to.?.* = p.pin;
+            }
+            self.none = to == null;
+            self.count = count;
+            self.last_dy = from.y - last.y;
+            self.to_dy = if (to) |p| from.y - p.y else 0;
+            self.generation = pages.history_generation;
+            self.valid = true;
+        }
+    };
+
+    fn isPrompt(pin: Pin) bool {
+        return !pin.garbage and pin.rowAndCell().row.semantic_prompt != .none;
+    }
+};
+
+/// Gathers, during a walk for some rows, the spans of prompts in history
+/// that Hint keeps: below the rows, the prompts from the newest in history
+/// to the one above them; at their top, the top prompt in them and the one
+/// above.
+const SpanLearner = struct {
+    /// Rows above this one are history.
+    active_top: u32,
+    below: Learning = .{},
+    above: Learning = .{},
+
+    const Learning = struct {
+        from: ?Row = null,
+        last: ?Row = null,
+        to: ?Row = null,
+        count: u32 = 0,
+        done: bool = false,
+    };
+
+    fn saw(self: *SpanLearner, rows: anytype, prompt: Row, under: ?Row, input: bool) void {
+        if (prompt.y > rows.bottom) {
+            if (prompt.y >= self.active_top) return;
+            if (self.below.from == null) {
+                self.below.from = prompt;
+                self.below.last = prompt;
+            } else {
+                if (input) self.below.count += 1;
+                self.below.last = prompt;
+            }
+            return;
+        }
+        if (self.below.from != null and !self.below.done) {
+            self.below.to = prompt;
+            self.below.done = true;
+        }
+        if (prompt.y < rows.top) self.top(rows, under, prompt);
+    }
+
+    fn skipped(self: *SpanLearner, s: Hint.Skip) void {
+        if (self.below.from == null or self.below.done) return;
+        self.below.count += s.count;
+        self.below.last = s.last;
+    }
+
+    /// The walk ended: no prompt above `last`, the last one it found.
+    fn ended(self: *SpanLearner, rows: anytype, last: ?Row) void {
+        if (self.below.from != null and !self.below.done) self.below.done = true;
+        self.top(rows, last, null);
+    }
+
+    /// `to` is the first prompt above `rows`, or none.
+    fn top(self: *SpanLearner, rows: anytype, under: ?Row, to: ?Row) void {
+        const from = under orelse return;
+        if (self.above.done or from.y < rows.top or from.y > rows.bottom or
+            from.y >= self.active_top) return;
+        self.above = .{ .from = from, .last = from, .to = to, .done = true };
+    }
+
+    fn teach(self: *const SpanLearner, hint: *Hint, screen: *Screen) void {
+        inline for (.{ .{ &hint.below, self.below }, .{ &hint.above, self.above } }) |pair| {
+            const l = pair[1];
+            if (l.done) if (l.from) |from| {
+                hint.own(screen);
+                pair[0].remember(&screen.pages, from, l.last.?, l.to, l.count);
+            };
+        }
+    }
+};
+
+/// A row and its screen row.
+const Row = struct {
+    pin: Pin,
+    y: u32,
+
+    fn up(self: Row) ?Row {
+        return .{ .pin = self.pin.up(1) orelse return null, .y = self.y - 1 };
+    }
+
+    fn eql(self: Row, other: Pin) bool {
+        return self.pin.node == other.node and self.pin.y == other.y;
+    }
+};
+
+/// Finds the first row of each prompt, from the bottom of the screen up,
+/// as a left_up PromptIterator does, counting screen rows on the way so
+/// that no position has to be looked up from the top.
+const Walk = struct {
+    screen: *Screen,
+    hint: ?*Hint,
+    bottom: Row,
+    /// The next row to look at.
+    current: ?Row,
+    /// The newest row of history, while this search has not passed it.
+    history: ?Pin,
+    /// The newest row of history once this search passed it.
+    passed: ?Row = null,
+    jump: ?Hint.Jump = null,
+
+    fn init(screen: *Screen, hint: ?*Hint) ?Walk {
+        const pages = &screen.pages;
+        var bottom = pages.getBottomRight(.screen) orelse return null;
+        bottom.x = 0;
+        const row: Row = .{ .pin = bottom, .y = @intCast(pages.total_rows - 1) };
+        var history = pages.getBottomRight(.history);
+        if (history) |*h| h.x = 0;
+        var walk: Walk = .{ .screen = screen, .hint = hint, .bottom = row, .current = row, .history = history };
+        if (hint) |h| walk.jump = h.jump(screen);
+        return walk;
+    }
+
+    fn next(self: *Walk) ?Row {
+        // A prompt continuation row seen: the prompt's first row so far.
+        var start: ?Row = null;
+        while (self.current) |row| {
+            if (self.history) |h| if (row.eql(h)) {
+                self.passed = row;
+                self.history = null;
+            };
+            if (start == null) if (self.jump) |j| if (row.eql(j.from)) {
+                self.jump = null;
+                // No prompt from here up.
+                const to = j.to orelse break;
+                // Never below the screen's first row.
+                if (j.dy <= row.y) {
+                    self.current = .{ .pin = to, .y = row.y - j.dy };
+                    continue;
+                }
+            };
+            switch (row.pin.rowAndCell().row.semantic_prompt) {
+                .none => if (start) |s| return self.found(s),
+                .prompt => {
+                    self.current = row.up();
+                    return self.found(row);
+                },
+                .prompt_continuation => start = row,
+            }
+            self.current = row.up();
+        } else if (start) |s| return self.found(s);
+        self.current = null;
+        self.learn(null);
+        return null;
+    }
+
+    fn found(self: *Walk, prompt: Row) Row {
+        self.learn(prompt);
+        return prompt;
+    }
+
+    /// After passing the newest row of history, the first prompt above it
+    /// (or that there is none) is worth remembering.
+    fn learn(self: *Walk, prompt: ?Row) void {
+        if (self.passed) |from| if (self.hint) |h| h.remember(self.screen, from, prompt);
+        self.passed = null;
+    }
+};
+
+pub const Part = enum { command, output, all };
+
+/// The part of the block whose first line is screen row `row`, with
+/// trailing blank space trimmed. Null when no block starts on that row or
+/// the part is empty (a command that printed nothing has no output).
+pub fn selection(screen: *const Screen, row: u32, part: Part) ?Selection {
+    const pages = &screen.pages;
+    const start = pages.pin(.{ .screen = .{ .y = row } }) orelse return null;
+    // The row must be the first row of a prompt, as highlightSemanticContent
+    // requires.
+    var it = start.promptIterator(.right_down, null);
+    const prompt = it.next() orelse return null;
+    if (prompt.node != start.node or prompt.y != start.y) return null;
+    if (!hasInput(prompt, it.next())) return null;
+
+    const input = pages.highlightSemanticContent(prompt, .input) orelse return null;
+    const output = pages.highlightSemanticContent(prompt, .output);
+    return switch (part) {
+        .command => .init(input.start, input.end, false),
+        .output => if (output) |o| .init(o.start, trimEnd(o.start, o.end), false) else null,
+        .all => .init(
+            prompt,
+            if (output) |o| trimEnd(o.start, o.end) else input.end,
+            false,
+        ),
+    };
+}
+
+/// True when the prompt starting at `prompt` has input with text before
+/// its output: a command was run there, and it is not the empty prompt
+/// waiting for the next one. `limit` is the first row of the next prompt.
+fn hasInput(prompt: Pin, limit: ?Pin) bool {
+    var cells = prompt.cellIterator(.right_down, limit);
+    while (cells.next()) |p| {
+        if (limit) |l| if (l.node == p.node and l.y == p.y) return false;
+        const cell = p.rowAndCell().cell;
+        switch (cell.semantic_content) {
+            .prompt => {},
+            .input => if (cell.hasText()) return true,
+            .output => if (cell.hasText()) return false,
+        }
+    }
+    return false;
+}
+
+/// The last row from `first` to `last` (inclusive) showing anything
+/// but spaces, or `first` when none does.
+fn lastRowWithText(first: Row, last: Row) Row {
+    var row = last;
+    while (row.y > first.y) {
+        if (rowHasText(row.pin)) return row;
+        row = row.up() orelse break;
+    }
+    return first;
+}
+
+/// True when the row `pin` is on shows anything but spaces.
+pub fn rowHasText(pin: Pin) bool {
+    for (pin.cells(.all)) |cell| {
+        if (cell.hasText() and cell.content.codepoint.data != ' ') return true;
+    }
+    return false;
+}
+
+/// Moves `end` back to the last cell with text, not before `start`.
+fn trimEnd(start: Pin, end: Pin) Pin {
+    var result = end;
+    var it = end.cellIterator(.left_up, start);
+    while (it.next()) |p| {
+        result = p;
+        if (p.rowAndCell().cell.hasText()) break;
+    }
+    return result;
+}
+
+// What a PrompTTY pane sends around each command: zsh with Ghostty's
+// integration (the marks), PrompTTY's (an empty prompt, input from the
+// bar, a blank row before the output and one after it) and another
+// integration that repeats the marks.
+const Session = struct {
+    const prompt =
+        "\r\x1b[0m\x1b[27m\x1b[24m\x1b[J\x1b]133;A;cl=line\x07\x1b]133;B\x07\x1b[K\x1b[6 q\x1b[K" ++
+        "\r\x1b[0m\x1b[27m\x1b[24m\x1b[J\x1b[K\x1b[?25l\x1b]133;P;k=i\x07\x1b]133;B\x07\x1b[5 q\x1b[?2004h";
+
+    fn command(comptime text: []const u8) []const u8 {
+        return "\x1b[K" ++ text[0..1] ++ "\r" ++ text ++ "\r\x1b[32m" ++ text ++ "\x1b[39m\x1b[5 q\x1b[?2004l\r\r\n" ++
+            "\x1b[6 q\x1b]133;C;\x07\x1b[?25h\x1b]133;C\x07\r\n\x1b]133;C\x07\x1b[0 q";
+    }
+
+    fn finished(comptime code: []const u8) []const u8 {
+        return "\x1b[1m\x1b[7m%\x1b[27m\x1b[1m\x1b[0m" ++ (" " ** 39) ++ "\r \r" ++
+            "\x1b]133;D;" ++ code ++ "\x07\x1b]133;L;gap=1\x07\x1b]133;D;" ++ code ++ "\x07";
+    }
+};

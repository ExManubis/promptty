+    try expectHinted(screen, &hint);
+    try expectHinted(screen, &hint);
+    s.nextSlice(comptime Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("pwd") ++ "/\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHinted(screen, &hint);
+
+    // A resize makes it start over; so does clearing the history.
+    try t.resize(alloc, .{ .cols = 30, .rows = 6 });
+    try testing.expect(hint.jump(screen) == null);
+    try expectHinted(screen, &hint);
+    s.nextSlice("\x1b[3J");
+    try expectHinted(screen, &hint);
+    s.nextSlice(comptime Session.prompt ++ Session.command("seq") ++ "1\r\n" ** 20 ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHinted(screen, &hint);
+}
+
+test "blocks: a hint whose prompt was pruned from the scrollback" {
+    const alloc = testing.allocator;
+    var t = try @import("Terminal.zig").init(std.testing.io, alloc, .{ .cols = 40, .rows = 5, .max_scrollback_bytes = 1 });
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 50);
+    try expectHinted(screen, &hint);
+    var lines: usize = 50;
+    while (screen.pages.total_rows > lines - 10) : (lines += 500) {
+        s.nextSlice("y\r\n" ** 500);
+        try expectHinted(screen, &hint);
+    }
+    // The running command's prompt is gone: the hint says nothing is above.
+    try testing.expect(hint.valid and hint.none);
+    s.nextSlice(comptime Session.finished("0") ++ Session.prompt ++ Session.command("ls") ++ "x\r\n" ++ Session.finished("1"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHinted(screen, &hint);
+}
+
+test "blocks: a hint does not survive a resize there and back" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 5);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 60);
+    try expectHinted(screen, &hint);
+    try testing.expect(hint.valid);
+    // Taller: the row the hint jumps from comes back on screen, while its
+    // prompt stays in history. Erasing history moves that prompt's pin to
+    // the top row, where new commands run, above the row it jumps from.
+    try t.resize(alloc, .{ .cols = 40, .rows = 30 });
+    s.nextSlice("\x1b[3J\x1b[H");
+    s.nextSlice(comptime Session.prompt ++ Session.command("a") ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("b") ++ Session.finished("1"));
+    s.nextSlice(comptime Session.prompt);
+    // Back to the size the hint was learned at.
+    try t.resize(alloc, .{ .cols = 40, .rows = 5 });
+    try expectHinted(screen, &hint);
+    var out: [8]Block = undefined;
+    try testing.expectEqual(2, list(screen, .all, &out, &hint).len);
+}
+
+test "blocks: a hinted walk scrolled back jumps above the screen" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 5);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("ls") ++ "x\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 60);
+    try expectHinted(screen, &hint);
+    s.nextSlice("y\r\n" ** 10);
+    // Rows 20-24, inside the running command's output: the newest row of
+    // history is below them and its prompt (row 4) above.
+    const range: Range = .{ .rows = .{ .top = 20, .bottom = 24 } };
+    {
+        const walk = Walk.init(screen, &hint).?;
+        try testing.expect(walk.jump != null);
+    }
+    try expectHintedRange(screen, &hint, range);
+    var out: [8]Block = undefined;
+    const listing = list(screen, range, &out, &hint);
+    try testing.expectEqual(1, listing.len);
+    try testing.expectEqual(0, listing.newer);
+    try testing.expectEqual(@as(u32, 4), out[0].row);
+}
+
+/// Lists the blocks on every screenful from the bottom up and back down
+/// with and without `hint` and expects the same.
+fn expectHintedScrolling(screen: *Screen, hint: *Hint) !void {
+    const rows: u32 = @intCast(screen.pages.rows);
+    const total: u32 = @intCast(screen.pages.total_rows);
+    var top: u32 = total - rows;
+    while (true) : (top -= 1) {
+        try expectHintedRange(screen, hint, .{ .rows = .{ .top = top, .bottom = top + rows - 1 } });
+        if (top == 0) break;
+    }
+    while (top + rows <= total) : (top += 3) {
+        try expectHintedRange(screen, hint, .{ .rows = .{ .top = top, .bottom = top + rows - 1 } });
+    }
+}
+
+test "blocks: a hinted walk scrolled back skips the prompts below the screen" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 5);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("ls") ++ "x\r\n" ** 20 ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("a") ++ Session.finished("1"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("b") ++ "y\r\n" ** 3 ++ Session.finished("2"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("c") ++ Session.finished("3"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 40);
+
+    // Rows 8-12, inside the output of ls (rows 0-21): the blocks after it
+    // are below the screen.
+    const range: Range = .{ .rows = .{ .top = 8, .bottom = 12 } };
+    try expectHintedRange(screen, &hint, range);
+    try testing.expect(hint.below.valid);
+    // The walk learned to go from the running command's prompt over the
+    // three after it to the one above the screen.
+    try testing.expectEqual(@as(u32, 3), hint.below.count);
+    try testing.expect(!hint.below.none);
+    try testing.expect(!hint.above.valid);
+
+    // While output streams, each listing jumps over them and is the same.
+    var i: usize = 0;
+    while (i < 10) : (i += 1) {
+        s.nextSlice("y\r\n" ** 7);
+        var out: [8]Block = undefined;
+        const listing = list(screen, range, &out, &hint);
+        try testing.expectEqual(@as(usize, 1), listing.len);
+        try testing.expectEqual(@as(u32, 4), listing.newer);
+        try testing.expectEqual(Block{ .row = 0, .end_row = 21, .exit_code = 0 }, out[0]);
+        try expectHintedRange(screen, &hint, range);
+    }
+
+    try expectHintedScrolling(screen, &hint);
+    s.nextSlice(comptime Session.finished("0") ++ Session.prompt ++ Session.command("pwd") ++ "/\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHintedScrolling(screen, &hint);
+    try t.resize(alloc, .{ .cols = 30, .rows = 7 });
+    try expectHintedScrolling(screen, &hint);
+}
+
+test "blocks: hinted walks over many commands, scrolled anywhere" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 6);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    var i: usize = 0;
+    while (i < 12) : (i += 1) {
+        s.nextSlice(comptime Session.prompt ++ Session.command("seq"));
+        var j: usize = 0;
+        while (j < (i * 7) % 11) : (j += 1) s.nextSlice("line\r\n");
+        s.nextSlice(comptime Session.finished("0"));
+        if (i % 3 == 0) s.nextSlice(comptime Session.prompt); // an empty prompt
+        try expectHintedScrolling(screen, &hint);
+    }
+    s.nextSlice(comptime Session.prompt);
+    try expectHintedScrolling(screen, &hint);
+}
+
+test "blocks: the exit status goes to the prompt found when output started" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 5);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 50);
+    try testing.expect(t.running_command.valid);
+    const prompt = t.running_command.pin.?.*;
+    s.nextSlice(comptime Session.finished("4"));
+    try testing.expectEqual(@as(u9, 5), prompt.rowAndCell().row.command_exit);
+    s.nextSlice(comptime Session.prompt);
+    try testing.expect(!t.running_command.valid);
+
+    // After a resize the prompt is found from the cursor again.
+    s.nextSlice(comptime Session.command("ls") ++ "x\r\n");
+    try t.resize(alloc, .{ .cols = 30, .rows = 5 });
+    s.nextSlice(comptime Session.finished("6"));
+    s.nextSlice(comptime Session.prompt);
+    var out: [4]Block = undefined;
+    const n = list(t.screens.active, .all, &out, null).len;
+    try testing.expectEqual(2, n);
+    try testing.expectEqual(@as(?u8, 4), out[0].exit_code);
+    try testing.expectEqual(@as(?u8, 6), out[1].exit_code);
+}

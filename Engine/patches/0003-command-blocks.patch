+test "blocks: rows asked for, the one before them, and how many come after" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 20);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("echo hello") ++ "hello\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("false") ++ Session.finished("1"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("printf") ++ "a\r\nb\r\nc\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    // Blocks on rows 0-2, 4-4 and 6-10.
+    const screen = t.screens.active;
+    var out: [8]Block = undefined;
+
+    // Row 5 (the gap) to 7: the third block, and the second before it.
+    var listing = list(screen, .{ .rows = .{ .top = 5, .bottom = 7 } }, &out, null);
+    try testing.expectEqual(2, listing.len);
+    try testing.expectEqual(0, listing.newer);
+    try testing.expectEqual(Block{ .row = 4, .end_row = 4, .exit_code = 1 }, out[0]);
+    try testing.expectEqual(Block{ .row = 6, .end_row = 10, .exit_code = 0 }, out[1]);
+
+    // Rows 1-2, inside the first: it is the one that started above.
+    listing = list(screen, .{ .rows = .{ .top = 1, .bottom = 2 } }, &out, null);
+    try testing.expectEqual(1, listing.len);
+    try testing.expectEqual(2, listing.newer);
+    try testing.expectEqual(Block{ .row = 0, .end_row = 2, .exit_code = 0 }, out[0]);
+
+    // Row 4 only: the second, the first before it, the third after.
+    listing = list(screen, .{ .rows = .{ .top = 4, .bottom = 4 } }, &out, null);
+    try testing.expectEqual(2, listing.len);
+    try testing.expectEqual(1, listing.newer);
+    try testing.expectEqual(@as(u32, 0), out[0].row);
+    try testing.expectEqual(@as(u32, 4), out[1].row);

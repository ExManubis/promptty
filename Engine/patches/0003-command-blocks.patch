diff --git a/src/terminal/blocks.zig b/src/terminal/blocks.zig
new file mode 100644
index 000000000..a0cacdd21
--- /dev/null
+++ b/src/terminal/blocks.zig
@@ -0,0 +1,659 @@
+//! Command blocks: each command the shell ran, found from its semantic
+//! prompt marks (OSC 133), with the output it printed. A block starts on
+//! the first row of a prompt that has input and runs to the last row with
+//! text before the next prompt.
+const std = @import("std");
+const testing = std.testing;
+const Screen = @import("Screen.zig");
+const PageList = @import("PageList.zig");
+const Pin = PageList.Pin;
+const Selection = @import("Selection.zig");
+
+pub const Block = struct {
+    /// Screen row of the block's first line: where its command is.
+    row: u32,
+
+    /// Screen row of the block's last line with text (at least `row`).
+    end_row: u32,
+
+    /// The command's exit status, when the shell reported it.
+    exit_code: ?u8,
+};
+
+/// Records the exit status the shell reported (OSC 133;D) on the prompt
+/// of the command that just finished: the nearest prompt at or above the
+/// cursor.
+pub fn markExit(screen: *Screen, code: i32) void {
+    var it = screen.cursor.page_pin.promptIterator(.left_up, null);
+    const prompt = it.next() orelse return;
+    const status: u8 = @intCast(std.math.clamp(code, 0, 255));
+    prompt.rowAndCell().row.command_exit = @as(u9, status) + 1;
+}
+
+/// Which blocks `list` writes.
+pub const Range = union(enum) {
+    /// The newest.
+    all,
+
+    /// Those with a row from `top` to `bottom` (screen rows, inclusive),
+    /// and the one before them: the overlay of a screen showing those rows
+    /// draws the line above the first and names a command scrolled off.
+    rows: struct { top: u32, bottom: u32 },
+};
+
+pub const Listing = struct {
+    /// How many blocks were written.
+    len: usize = 0,
+
+    /// How many blocks come after the last one written: those that start
+    /// below the rows asked for.
+    newer: u32 = 0,
+};
+
+/// Fills `out` with the blocks on `screen` in `range`, the newest that
+/// fit, oldest first. One walk up from the bottom of the screen that ends
+/// as soon as `range` is covered; with a `hint` kept between calls, it
+/// also skips the history it walked through before.
+pub fn list(screen: *Screen, range: Range, out: []Block, hint: ?*Hint) Listing {
+    var result: Listing = .{};
+    if (out.len == 0 or !screen.semantic_prompt.seen) return result;
+    var walk = Walk.init(screen, hint) orelse return result;
+
+    // The first row of the prompt below the one being looked at.
+    var below: ?Row = null;
+    while (walk.next()) |prompt| {
+        defer below = prompt;
+        if (!hasInput(prompt.pin, if (below) |b| b.pin else null)) continue;
+        const above_range = switch (range) {
+            .all => false,
+            .rows => |rows| above: {
+                if (prompt.y > rows.bottom) {
+                    result.newer += 1;
+                    continue;
+                }
+                break :above prompt.y < rows.top;
+            },
+        };
+        const last: Row = if (below) |b| (b.up() orelse prompt) else walk.bottom;
+        const command_exit = prompt.pin.rowAndCell().row.command_exit;
+        out[result.len] = .{
+            .row = prompt.y,
+            .end_row = lastRowWithText(prompt, last).y,
+            .exit_code = if (command_exit == 0) null else @intCast(command_exit - 1),
+        };
+        result.len += 1;
+        if (result.len == out.len or above_range) break;
+    }
+    std.mem.reverse(Block, out[0..result.len]);
+    return result;
+}
+
+/// What a walk up the screen learned after passing the newest row of
+/// history: where the nearest prompt above it is, or that there is none.
+/// The next walk can jump from that row straight to the prompt (or stop
+/// there): history rows change only by being pruned (which marks the pins
+/// garbage) or by a resize, erase or reset (which the page list counts).
+/// Keep one per terminal. Its pins are tracked by the screen's page list
+/// and freed with it.
+pub const Hint = struct {
+    screen: ?*const Screen = null,
+    /// A row of history...
+    from: ?*Pin = null,
+    /// ...and the first row of the nearest prompt at or above it, unless
+    /// `none`: no prompt at or above it.
+    prompt: ?*Pin = null,
+    none: bool = false,
+    /// The page list's history_generation when it was learned.
+    generation: u32 = 0,
+    valid: bool = false,
+
+    const Jump = struct { from: Pin, to: ?Pin };
+
+    fn jump(self: *Hint, screen: *const Screen) ?Jump {
+        if (!self.valid or self.screen != screen) return null;
+        const from = self.from.?.*;
+        const to: ?Pin = if (self.none) null else self.prompt.?.*;
+        if (self.generation != screen.pages.history_generation or from.garbage or
+            if (to) |p| p.garbage or p.rowAndCell().row.semantic_prompt == .none else false)
+        {
+            self.valid = false;
+            return null;
+        }
+        return .{ .from = from, .to = to };
+    }
+
+    fn remember(self: *Hint, screen: *Screen, from: Pin, prompt: ?Pin) void {
+        const pages = &screen.pages;
+        // Pins of another screen stay with its page list.
+        if (self.screen != screen) self.* = .{ .screen = screen };
+        self.valid = false;
+        if (self.from == null) self.from = pages.trackPin(from) catch return;
+        self.from.?.* = from;
+        if (prompt) |p| {
+            if (self.prompt == null) self.prompt = pages.trackPin(p) catch return;
+            self.prompt.?.* = p;
+        }
+        self.none = prompt == null;
+        self.generation = pages.history_generation;
+        self.valid = true;
+    }
+};
+
+/// A row and its screen row.
+const Row = struct {
+    pin: Pin,
+    y: u32,
+
+    fn up(self: Row) ?Row {
+        return .{ .pin = self.pin.up(1) orelse return null, .y = self.y - 1 };
+    }
+
+    fn eql(self: Row, other: Pin) bool {
+        return self.pin.node == other.node and self.pin.y == other.y;
+    }
+};
+
+/// Finds the first row of each prompt, from the bottom of the screen up,
+/// as a left_up PromptIterator does, counting screen rows on the way so
+/// that no position has to be looked up from the top.
+const Walk = struct {
+    screen: *Screen,
+    hint: ?*Hint,
+    bottom: Row,
+    /// The next row to look at.
+    current: ?Row,
+    /// The newest row of history, while this search has not passed it.
+    history: ?Pin,
+    /// The newest row of history once this search passed it.
+    passed: ?Pin = null,
+    jump: ?Hint.Jump = null,
+
+    fn init(screen: *Screen, hint: ?*Hint) ?Walk {
+        const pages = &screen.pages;
+        var bottom = pages.getBottomRight(.screen) orelse return null;
+        bottom.x = 0;
+        const row: Row = .{ .pin = bottom, .y = @intCast(pages.total_rows - 1) };
+        var history = pages.getBottomRight(.history);
+        if (history) |*h| h.x = 0;
+        var walk: Walk = .{ .screen = screen, .hint = hint, .bottom = row, .current = row, .history = history };
+        if (hint) |h| walk.jump = h.jump(screen);
+        return walk;
+    }
+
+    fn next(self: *Walk) ?Row {
+        // A prompt continuation row seen: the prompt's first row so far.
+        var start: ?Row = null;
+        while (self.current) |row| {
+            if (self.history) |h| if (row.eql(h)) {
+                self.passed = h;
+                self.history = null;
+            };
+            if (start == null) if (self.jump) |j| if (row.eql(j.from)) {
+                self.jump = null;
+                // No prompt from here up.
+                const to = j.to orelse break;
+                // Never down, which would find prompts twice.
+                if (self.screen.pages.pointFromPin(.screen, to)) |pt| if (pt.coord().y <= row.y) {
+                    self.current = .{ .pin = to, .y = @intCast(pt.coord().y) };
+                    continue;
+                };
+            };
+            switch (row.pin.rowAndCell().row.semantic_prompt) {
+                .none => if (start) |s| return self.found(s),
+                .prompt => {
+                    self.current = row.up();
+                    return self.found(row);
+                },
+                .prompt_continuation => start = row,
+            }
+            self.current = row.up();
+        } else if (start) |s| return self.found(s);
+        self.current = null;
+        self.learn(null);
+        return null;
+    }
+
+    fn found(self: *Walk, prompt: Row) Row {
+        self.learn(prompt.pin);
+        return prompt;
+    }
+
+    /// After passing the newest row of history, the first prompt above it
+    /// (or that there is none) is worth remembering.
+    fn learn(self: *Walk, prompt: ?Pin) void {
+        if (self.passed) |from| if (self.hint) |h| h.remember(self.screen, from, prompt);
+        self.passed = null;
+    }
+};
+
+pub const Part = enum { command, output, all };
+
+/// The part of the block whose first line is screen row `row`, with
+/// trailing blank space trimmed. Null when no block starts on that row or
+/// the part is empty (a command that printed nothing has no output).
+pub fn selection(screen: *const Screen, row: u32, part: Part) ?Selection {
+    const pages = &screen.pages;
+    const start = pages.pin(.{ .screen = .{ .y = row } }) orelse return null;
+    // The row must be the first row of a prompt, as highlightSemanticContent
+    // requires.
+    var it = start.promptIterator(.right_down, null);
+    const prompt = it.next() orelse return null;
+    if (prompt.node != start.node or prompt.y != start.y) return null;
+    if (!hasInput(prompt, it.next())) return null;
+
+    const input = pages.highlightSemanticContent(prompt, .input) orelse return null;
+    const output = pages.highlightSemanticContent(prompt, .output);
+    return switch (part) {
+        .command => .init(input.start, input.end, false),
+        .output => if (output) |o| .init(o.start, trimEnd(o.start, o.end), false) else null,
+        .all => .init(
+            prompt,
+            if (output) |o| trimEnd(o.start, o.end) else input.end,
+            false,
+        ),
+    };
+}
+
+/// True when the prompt starting at `prompt` has input with text before
+/// its output: a command was run there, and it is not the empty prompt
+/// waiting for the next one. `limit` is the first row of the next prompt.
+fn hasInput(prompt: Pin, limit: ?Pin) bool {
+    var cells = prompt.cellIterator(.right_down, limit);
+    while (cells.next()) |p| {
+        if (limit) |l| if (l.node == p.node and l.y == p.y) return false;
+        const cell = p.rowAndCell().cell;
+        switch (cell.semantic_content) {
+            .prompt => {},
+            .input => if (cell.hasText()) return true,
+            .output => if (cell.hasText()) return false,
+        }
+    }
+    return false;
+}
+
+/// The last row from `first` to `last` (inclusive) showing anything
+/// but spaces, or `first` when none does.
+fn lastRowWithText(first: Row, last: Row) Row {
+    var row = last;
+    while (row.y > first.y) {
+        if (rowHasText(row.pin)) return row;
+        row = row.up() orelse break;
+    }
+    return first;
+}
+
+/// True when the row `pin` is on shows anything but spaces.
+pub fn rowHasText(pin: Pin) bool {
+    for (pin.cells(.all)) |cell| {
+        if (cell.hasText() and cell.content.codepoint != ' ') return true;
+    }
+    return false;
+}
+
+/// Moves `end` back to the last cell with text, not before `start`.
+fn trimEnd(start: Pin, end: Pin) Pin {
+    var result = end;
+    var it = end.cellIterator(.left_up, start);
+    while (it.next()) |p| {
+        result = p;
+        if (p.rowAndCell().cell.hasText()) break;
+    }
+    return result;
+}
+
+// What a PrompTTY pane sends around each command: zsh with Ghostty's
+// integration (the marks), PrompTTY's (an empty prompt, input from the
+// bar, a blank row before the output and one after it) and another
+// integration that repeats the marks.
+const Session = struct {
+    const prompt =
+        "\r\x1b[0m\x1b[27m\x1b[24m\x1b[J\x1b]133;A;cl=line\x07\x1b]133;B\x07\x1b[K\x1b[6 q\x1b[K" ++
+        "\r\x1b[0m\x1b[27m\x1b[24m\x1b[J\x1b[K\x1b[?25l\x1b]133;P;k=i\x07\x1b]133;B\x07\x1b[5 q\x1b[?2004h";
+
+    fn command(comptime text: []const u8) []const u8 {
+        return "\x1b[K" ++ text[0..1] ++ "\r" ++ text ++ "\r\x1b[32m" ++ text ++ "\x1b[39m\x1b[5 q\x1b[?2004l\r\r\n" ++
+            "\x1b[6 q\x1b]133;C;\x07\x1b[?25h\x1b]133;C\x07\r\n\x1b]133;C\x07\x1b[0 q";
+    }
+
+    fn finished(comptime code: []const u8) []const u8 {
+        return "\x1b[1m\x1b[7m%\x1b[27m\x1b[1m\x1b[0m" ++ (" " ** 39) ++ "\r \r" ++
+            "\x1b]133;D;" ++ code ++ "\x07\x1b]133;L;gap=1\x07\x1b]133;D;" ++ code ++ "\x07";
+    }
+};
+
+fn testTerminal(alloc: std.mem.Allocator, rows: u16) !@import("Terminal.zig") {
+    return try .init(alloc, .{ .cols = 40, .rows = rows });
+}
+
+fn testText(alloc: std.mem.Allocator, screen: *Screen, sel: Selection) ![:0]const u8 {
+    return try screen.selectionString(alloc, .{ .sel = sel, .trim = true });
+}
+
+test "blocks: commands with and without output" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 20);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("echo hello") ++ "hello\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("false") ++ Session.finished("1"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("printf") ++ "a\r\nb\r\nc\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+
+    var out: [8]Block = undefined;
+    const n = list(t.screens.active, .all, &out, null).len;
+    try testing.expectEqual(3, n);
+    // A blank row between each command and its output, and one after: a
+    // command that printed nothing has only the one.
+    try testing.expectEqual(Block{ .row = 0, .end_row = 2, .exit_code = 0 }, out[0]);
+    try testing.expectEqual(Block{ .row = 4, .end_row = 4, .exit_code = 1 }, out[1]);
+    try testing.expectEqual(Block{ .row = 6, .end_row = 10, .exit_code = 0 }, out[2]);
+
+    const screen = t.screens.active;
+    {
+        const text = try testText(alloc, screen, selection(screen, 0, .command).?);
+        defer alloc.free(text);
+        try testing.expectEqualStrings("echo hello", text);
+    }
+    {
+        const text = try testText(alloc, screen, selection(screen, 0, .output).?);
+        defer alloc.free(text);
+        try testing.expectEqualStrings("hello", text);
+    }
+    {
+        const text = try testText(alloc, screen, selection(screen, 6, .output).?);
+        defer alloc.free(text);
+        try testing.expectEqualStrings("a\nb\nc", text);
+    }
+    {
+        const text = try testText(alloc, screen, selection(screen, 6, .all).?);
+        defer alloc.free(text);
+        try testing.expectEqualStrings("printf\n\na\nb\nc", text);
+    }
+    try testing.expect(selection(screen, 4, .output) == null);
+    // Rows that do not start a block: blank, output, the empty prompt, nothing.
+    try testing.expect(selection(screen, 1, .command) == null);
+    try testing.expect(selection(screen, 2, .command) == null);
+    try testing.expect(selection(screen, 12, .command) == null);
+    try testing.expect(selection(screen, 19, .command) == null);
+}

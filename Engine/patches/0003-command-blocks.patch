+/// Lists blocks in `range` with and without `hint` and expects the same.
+fn expectHintedRange(screen: *Screen, hint: *Hint, range: Range) !void {
+    var plain: [64]Block = undefined;
+    var hinted: [64]Block = undefined;
+    const a = list(screen, range, &plain, null);
+    const b = list(screen, range, &hinted, hint);
+    try testing.expectEqual(a, b);
+    try testing.expectEqualSlices(Block, plain[0..a.len], hinted[0..b.len]);
+}
+
+/// Lists all blocks and those on the bottom screen with and without
+/// `hint` and expects the same.
+fn expectHinted(screen: *Screen, hint: *Hint) !void {
+    try expectHintedRange(screen, hint, .all);
+    const bottom: u32 = @intCast(screen.pages.total_rows - 1);
+    const top: u32 = bottom + 1 - screen.pages.rows;
+    try expectHintedRange(screen, hint, .{ .rows = .{ .top = top, .bottom = bottom } });
+}
+
+test "blocks: a hint skips history and gives the same blocks" {
+    const alloc = testing.allocator;
+    var t = try testTerminal(alloc, 5);
+    defer t.deinit(alloc);
+    var s = t.vtStream();
+    defer s.deinit();
+    const screen = t.screens.active;
+    var hint: Hint = .{};
+
+    s.nextSlice(comptime Session.prompt ++ Session.command("ls") ++ "x\r\n" ++ Session.finished("2"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("yes") ++ "y\r\n" ** 30);
+    try expectHinted(screen, &hint);
+    // The walk passed history and found the running command's prompt.
+    try testing.expect(hint.jump(screen) != null);
+    // More output: the next walk jumps from where the last one passed.
+    s.nextSlice("y\r\n" ** 30);
+    {
+        var walk = Walk.init(screen, &hint).?;
+        try testing.expect(walk.jump != null);
+        while (walk.next()) |_| {}
+        try testing.expect(walk.jump == null);
+    }
+    try expectHinted(screen, &hint);
+    try expectHinted(screen, &hint);
+    s.nextSlice(comptime Session.finished("0"));
+    s.nextSlice(comptime Session.prompt ++ Session.command("pwd") ++ "/\r\n" ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHinted(screen, &hint);
+
+    // A resize makes it start over; so does clearing the history.
+    try t.resize(alloc, 30, 6);
+    try testing.expect(hint.jump(screen) == null);
+    try expectHinted(screen, &hint);
+    s.nextSlice("\x1b[3J");
+    try expectHinted(screen, &hint);
+    s.nextSlice(comptime Session.prompt ++ Session.command("seq") ++ "1\r\n" ** 20 ++ Session.finished("0"));
+    s.nextSlice(comptime Session.prompt);
+    try expectHinted(screen, &hint);
+}

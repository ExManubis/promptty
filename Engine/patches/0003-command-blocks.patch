+/// Lists all blocks and those on the bottom screen with and without
+/// `hint` and expects the same.
+fn expectHinted(screen: *Screen, hint: *Hint) !void {
+    try expectHintedRange(screen, hint, .all);
+    const bottom: u32 = @intCast(screen.pages.total_rows - 1);
+    const top: u32 = bottom + 1 - screen.pages.rows;
+    try expectHintedRange(screen, hint, .{ .rows = .{ .top = top, .bottom = bottom } });
+}

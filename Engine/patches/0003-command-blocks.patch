+/// Lists blocks in `range` with and without `hint` and expects the same.
+fn expectHintedRange(screen: *Screen, hint: *Hint, range: Range) !void {
+    var plain: [64]Block = undefined;
+    var hinted: [64]Block = undefined;
+    const a = list(screen, range, &plain, null);
+    const b = list(screen, range, &hinted, hint);
+    try testing.expectEqual(a, b);
+    try testing.expectEqualSlices(Block, plain[0..a.len], hinted[0..b.len]);
+}

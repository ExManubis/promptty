+    export fn ghostty_surface_blocks(
+        surface: *Surface,
+        info: *BlocksInfo,
+        out: [*]Block,
+        cap: usize,
+    ) usize {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const t = core_surface.renderer_state.terminal;
+        const screen = t.screens.active;
+        const pages = &screen.pages;
+        const top = pages.pointFromPin(.screen, pages.getTopLeft(.viewport));
+        const bottom = if (pages.getBottomRight(.screen)) |br| pages.pointFromPin(.screen, br) else null;

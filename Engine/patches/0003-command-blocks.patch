+    // The gap row holds nothing, not even the spaces a shell printed there.
+    s.nextSlice("x\r\n   \r\x1b]133;L;gap=1\x07");
+    try testing.expectEqual(@as(usize, 6), t.screens.active.cursor.y);
+    const gap = t.screens.active.cursor.page_pin.up(1).?;
+    for (gap.cells(.all)) |cell| try testing.expect(!cell.hasText());

diff --git a/src/termio/OutputTap.zig b/src/termio/OutputTap.zig
new file mode 100644
index 000000000..c24602b35
--- /dev/null
+++ b/src/termio/OutputTap.zig
@@ -0,0 +1,79 @@
+//! PrompTTY: a tap on a surface's pty output, for mirroring the surface
+//! elsewhere. Termio hands it each chunk it reads from the pty, exactly as
+//! read and before it is parsed, on the read thread and with the renderer
+//! state mutex held, so a reader that takes that mutex sees the terminal
+//! either before a chunk or after it, never halfway. Whoever sets the tap
+//! must hold the same mutex; with no tap set, a chunk costs one check.
+const OutputTap = @This();
+
+const std = @import("std");
+
+/// Called with a chunk of pty output. The bytes are only valid for the
+/// duration of the call, so the callee copies what it keeps. It runs with
+/// the renderer state mutex held: it must return quickly and must not call
+/// back into the surface.
+pub const Callback = *const fn (
+    userdata: ?*anyopaque,
+    bytes: [*]const u8,
+    len: usize,
+) callconv(.c) void;
+
+callback: ?Callback = null,
+userdata: ?*anyopaque = null,
+
+/// Hands `buf` to the callback, if one is set.
+pub fn emit(self: OutputTap, buf: []const u8) void {
+    const callback = self.callback orelse return;
+    if (buf.len == 0) return;
+    callback(self.userdata, buf.ptr, buf.len);
+}
+
+const Recorder = struct {
+    bytes: std.ArrayList(u8) = .empty,
+    calls: usize = 0,
+
+    fn record(userdata: ?*anyopaque, bytes: [*]const u8, len: usize) callconv(.c) void {
+        const self: *Recorder = @ptrCast(@alignCast(userdata.?));
+        self.calls += 1;
+        self.bytes.appendSlice(std.testing.allocator, bytes[0..len]) catch unreachable;
+    }
+};
+
+test "output_tap: chunks arrive unchanged, escape sequences included" {
+    var recorder: Recorder = .{};
+    defer recorder.bytes.deinit(std.testing.allocator);
+    const tap: OutputTap = .{ .callback = Recorder.record, .userdata = &recorder };
+
+    const chunks = [_][]const u8{
+        "hello \x1b[1;31mred\x1b[0m\r\n",
+        "\x1b]133;D;0\x07\x1b]7;file://host/tmp\x1b\\",
+        "\x00\xff\xc3", // a split UTF-8 sequence and bytes that aren't text
+        "\xa9 done\r\n",
+    };
+    for (chunks) |chunk| tap.emit(chunk);
+
+    try std.testing.expectEqual(chunks.len, recorder.calls);
+    try std.testing.expectEqualStrings(
+        "hello \x1b[1;31mred\x1b[0m\r\n" ++
+            "\x1b]133;D;0\x07\x1b]7;file://host/tmp\x1b\\" ++
+            "\x00\xff\xc3" ++
+            "\xa9 done\r\n",
+        recorder.bytes.items,
+    );
+}
+
+test "output_tap: no callback for an empty chunk or with the tap off" {
+    var recorder: Recorder = .{};
+    defer recorder.bytes.deinit(std.testing.allocator);
+    var tap: OutputTap = .{ .callback = Recorder.record, .userdata = &recorder };
+
+    tap.emit("");
+    try std.testing.expectEqual(0, recorder.calls);
+    tap.emit("on");
+    try std.testing.expectEqual(1, recorder.calls);
+
+    tap = .{};
+    tap.emit("off");
+    try std.testing.expectEqual(1, recorder.calls);
+    try std.testing.expectEqualStrings("on", recorder.bytes.items);
+}

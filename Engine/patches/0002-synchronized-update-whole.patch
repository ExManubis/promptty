diff --git a/src/termio/sync_hold.zig b/src/termio/sync_hold.zig
new file mode 100644
index 000000000..d48a28140
--- /dev/null
+++ b/src/termio/sync_hold.zig
@@ -0,0 +1,281 @@
+//! Holds back the bytes of a synchronized update (DEC mode 2026) until the
+//! update ends, then hands the whole update to the parser at once.
+//!
+//! The renderer skips frames while synchronized output is on. A program that
+//! streams its updates back to back (Claude Code, through Ink, sends a whole
+//! screen per update, one right after another) leaves it almost no moment in
+//! which the mode is off: parsed as it arrives, the stream is inside an update
+//! nearly all the time, and only now and then does the renderer happen to look
+//! between two, so it shows a few frames a second. Parsed whole, an update
+//! turns the mode on and off within one critical section, and the terminal
+//! always holds the last complete frame.
+//!
+//! Output that is not part of an update passes straight through.
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+const SyncHold = @This();
+
+pub const start = "\x1b[?2026h";
+pub const end = "\x1b[?2026l";
+
+/// An update this large is parsed as it stands; the renderer still waits for
+/// its end, as it would without holding it back.
+max_bytes: usize = 16 * 1024 * 1024,
+
+/// Bytes not parsed yet: an update that has not ended, or the start of what
+/// may be the sequence that begins one.
+buf: std.ArrayListUnmanaged(u8) = .empty,
+
+/// `buf` begins with an update's start sequence.
+in_update: bool = false,
+
+/// Where to look for the end sequence next, so a long update is not scanned
+/// again from its start for every chunk.
+scan_from: usize = 0,
+
+pub fn deinit(self: *SyncHold, alloc: Allocator) void {
+    self.buf.deinit(alloc);
+}
+
+/// True when bytes are held back; `flush` parses them.
+pub fn holding(self: *const SyncHold) bool {
+    return self.buf.items.len > 0;
+}
+
+/// Takes the next chunk of output and calls `parse` with what may be parsed
+/// now, in order: output outside updates, and whole updates.
+pub fn feed(
+    self: *SyncHold,
+    alloc: Allocator,
+    data: []const u8,
+    ctx: anytype,
+    comptime parse: fn (@TypeOf(ctx), []const u8) void,
+) void {
+    // Nothing held back and no update starting: the common case.
+    if (self.buf.items.len == 0 and
+        std.mem.indexOf(u8, data, start) == null and
+        partialSuffix(data, start) == 0)
+    {
+        parse(ctx, data);
+        return;
+    }
+
+    self.buf.appendSlice(alloc, data) catch {
+        // Out of memory: stop holding back.
+        self.flush(ctx, parse);
+        parse(ctx, data);
+        return;
+    };
+    self.process(ctx, parse, false);
+}
+
+/// Parses everything held back, an unfinished update included (the program
+/// went quiet in the middle of one, e.g. waiting for a reply to a query).
+pub fn flush(
+    self: *SyncHold,
+    ctx: anytype,
+    comptime parse: fn (@TypeOf(ctx), []const u8) void,
+) void {
+    self.process(ctx, parse, true);
+}
+
+fn process(
+    self: *SyncHold,
+    ctx: anytype,
+    comptime parse: fn (@TypeOf(ctx), []const u8) void,
+    force: bool,
+) void {
+    const data = self.buf.items;
+    var i: usize = 0;
+    while (i < data.len) {
+        if (!self.in_update) {
+            if (std.mem.indexOfPos(u8, data, i, start)) |s| {
+                if (s > i) parse(ctx, data[i..s]);
+                i = s;
+                self.in_update = true;
+                self.scan_from = s + start.len;
+                continue;
+            }
+
+            // No update starting: parse all but a tail that may be the
+            // first bytes of a start sequence split across reads.
+            const keep = if (force) 0 else partialSuffix(data[i..], start);
+            if (data.len - keep > i) parse(ctx, data[i .. data.len - keep]);
+            i = data.len - keep;
+            break;
+        }
+
+        if (std.mem.indexOfPos(u8, data, @max(self.scan_from, i + start.len), end)) |e| {
+            const stop = e + end.len;
+            parse(ctx, data[i..stop]);
+            i = stop;
+            self.in_update = false;
+            continue;
+        }
+
+        if (force or data.len - i > self.max_bytes) {
+            parse(ctx, data[i..]);
+            i = data.len;
+            self.in_update = false;
+            break;
+        }
+
+        // Unfinished: wait for more. The end sequence may straddle the
+        // next read, so look again from just before the current end.
+        self.scan_from = @max(i + start.len, data.len -| (end.len - 1));
+        break;
+    }
+
+    // Keep what is not parsed yet at the front of the buffer.
+    const rest = data.len - i;
+    std.mem.copyForwards(u8, self.buf.items[0..rest], data[i..]);
+    self.buf.shrinkRetainingCapacity(rest);
+    self.scan_from -|= i;
+}
+
+/// The length of the longest proper prefix of `pattern` that `data` ends with.
+fn partialSuffix(data: []const u8, pattern: []const u8) usize {
+    var k: usize = @min(data.len, pattern.len - 1);
+    while (k > 0) : (k -= 1) {
+        if (std.mem.eql(u8, data[data.len - k ..], pattern[0..k])) return k;
+    }
+    return 0;
+}
+
+// Tests
+
+const Recorder = struct {
+    alloc: Allocator,
+    calls: std.ArrayListUnmanaged([]u8) = .empty,
+
+    fn parse(self: *Recorder, bytes: []const u8) void {
+        self.calls.append(self.alloc, self.alloc.dupe(u8, bytes) catch unreachable) catch unreachable;
+    }
+
+    fn deinit(self: *Recorder) void {
+        for (self.calls.items) |c| self.alloc.free(c);
+        self.calls.deinit(self.alloc);
+    }
+
+    fn joined(self: *const Recorder) ![]u8 {
+        return std.mem.concat(self.alloc, u8, self.calls.items);
+    }
+};
+
+test "output outside updates passes straight through" {
+    const alloc = std.testing.allocator;
+    var hold: SyncHold = .{};
+    defer hold.deinit(alloc);
+    var rec: Recorder = .{ .alloc = alloc };
+    defer rec.deinit();
+
+    hold.feed(alloc, "hello", &rec, Recorder.parse);
+    hold.feed(alloc, " world", &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 2), rec.calls.items.len);
+    try std.testing.expectEqualStrings("hello", rec.calls.items[0]);
+    try std.testing.expect(!hold.holding());
+}
+
+test "an update split across reads is parsed whole when it ends" {
+    const alloc = std.testing.allocator;
+    var hold: SyncHold = .{};
+    defer hold.deinit(alloc);
+    var rec: Recorder = .{ .alloc = alloc };
+    defer rec.deinit();
+
+    hold.feed(alloc, "before" ++ start ++ "fra", &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 1), rec.calls.items.len);
+    try std.testing.expectEqualStrings("before", rec.calls.items[0]);
+    try std.testing.expect(hold.holding());
+
+    hold.feed(alloc, "me" ++ end ++ "after", &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 3), rec.calls.items.len);
+    try std.testing.expectEqualStrings(start ++ "frame" ++ end, rec.calls.items[1]);
+    try std.testing.expectEqualStrings("after", rec.calls.items[2]);
+    try std.testing.expect(!hold.holding());
+}
+
+test "back-to-back updates are each parsed whole" {
+    const alloc = std.testing.allocator;
+    var hold: SyncHold = .{};
+    defer hold.deinit(alloc);
+    var rec: Recorder = .{ .alloc = alloc };
+    defer rec.deinit();
+
+    const two = start ++ "one" ++ end ++ start ++ "two" ++ end ++ start ++ "thr";
+    hold.feed(alloc, two, &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 2), rec.calls.items.len);
+    try std.testing.expectEqualStrings(start ++ "one" ++ end, rec.calls.items[0]);
+    try std.testing.expectEqualStrings(start ++ "two" ++ end, rec.calls.items[1]);
+    try std.testing.expect(hold.holding());
+}
+
+test "sequences split at any byte are still found" {
+    const alloc = std.testing.allocator;
+    const stream = "a" ++ start ++ "frame one" ++ end ++ "b" ++ start ++ "frame two" ++ end ++ "c";
+    var split: usize = 1;
+    while (split < stream.len) : (split += 1) {
+        var hold: SyncHold = .{};
+        defer hold.deinit(alloc);
+        var rec: Recorder = .{ .alloc = alloc };
+        defer rec.deinit();
+
+        // Fed one byte at a time from `split` on, as small reads do.
+        hold.feed(alloc, stream[0..split], &rec, Recorder.parse);
+        for (stream[split..]) |byte| hold.feed(alloc, &.{byte}, &rec, Recorder.parse);
+
+        const all = try rec.joined();
+        defer alloc.free(all);
+        try std.testing.expectEqualStrings(stream, all);
+        // Each update arrived in one call.
+        var whole: usize = 0;
+        for (rec.calls.items) |c| {
+            if (std.mem.indexOf(u8, c, start) != null) {
+                try std.testing.expect(std.mem.endsWith(u8, c, end));
+                try std.testing.expect(std.mem.startsWith(u8, c, start));
+                whole += 1;
+            }
+        }
+        try std.testing.expectEqual(@as(usize, 2), whole);
+    }
+}
+
+test "flush parses an unfinished update and anything held" {
+    const alloc = std.testing.allocator;
+    var hold: SyncHold = .{};
+    defer hold.deinit(alloc);
+    var rec: Recorder = .{ .alloc = alloc };
+    defer rec.deinit();
+
+    hold.feed(alloc, start ++ "half", &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 0), rec.calls.items.len);
+    hold.flush(&rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 1), rec.calls.items.len);
+    try std.testing.expect(!hold.holding());
+
+    // The rest of that update, and its end, then pass straight through.
+    hold.feed(alloc, " more" ++ end, &rec, Recorder.parse);
+    const all = try rec.joined();
+    defer alloc.free(all);
+    try std.testing.expectEqualStrings(start ++ "half more" ++ end, all);
+
+    // A lone escape at the end of a read is held, then flushed.
+    hold.feed(alloc, "x\x1b", &rec, Recorder.parse);
+    try std.testing.expect(hold.holding());
+    hold.flush(&rec, Recorder.parse);
+    try std.testing.expect(!hold.holding());
+}
+
+test "an update larger than the limit is parsed as it stands" {
+    const alloc = std.testing.allocator;
+    var hold: SyncHold = .{ .max_bytes = 16 };
+    defer hold.deinit(alloc);
+    var rec: Recorder = .{ .alloc = alloc };
+    defer rec.deinit();
+
+    hold.feed(alloc, start ++ "0123456789abcdefXYZ", &rec, Recorder.parse);
+    try std.testing.expectEqual(@as(usize, 1), rec.calls.items.len);
+    try std.testing.expect(!hold.holding());
+}

+/// PrompTTY: the terminal as VT bytes that rebuild it in a fresh terminal of
+/// the same size (terminal/vt_snapshot.zig, as ghostty_surface_read_vt_snapshot
+/// gives a surface's): at most `scrollback` rows of scrollback, the screen,
+/// cursor, modes and the alternate screen, then the sequence the input stopped
+/// in the middle of. Free with ghostty_free and the same allocator.
+pub fn vt_snapshot_alloc(
+    terminal_: Terminal,
+    scrollback: u32,
+    alloc_: ?*const CAllocator,
+    out_ptr_: ?*?[*]u8,
+    out_len_: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const out_ptr = out_ptr_ orelse return .invalid_value;
+    const out_len = out_len_ orelse return .invalid_value;
+    out_ptr.* = null;
+    out_len.* = 0;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const alloc = lib.alloc.default(alloc_);
+
+    var aw: std.Io.Writer.Allocating = .init(alloc);
+    defer aw.deinit();
+    vt_snapshot.write(alloc, wrapper.terminal, &aw.writer, .{
+        .scrollback = scrollback,
+    }) catch return .out_of_memory;
+    // The sequence the input stopped in the middle of, when it is tracked.
+    wrapper.stream.writeContinuation(&aw.writer) catch |err| switch (err) {
+        error.WriteFailed => return .out_of_memory,
+        else => {},
+    };
+
+    const bytes = aw.toOwnedSlice() catch return .out_of_memory;
+    out_ptr.* = if (bytes.len == 0) null else bytes.ptr;
+    out_len.* = bytes.len;
+    return .success;
+}
